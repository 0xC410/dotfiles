" ~/.vimrc

set expandtab
set tabstop=4
set shiftwidth=4
set softtabstop=4

set autoindent

set number
set relativenumber

set hlsearch
set incsearch

set ignorecase
set smartcase

" Mostra comandos parcialmente digitados
set showcmd

set ruler

set linebreak

syntax on
colo habamax

filetype plugin indent on
